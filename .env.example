# Telegram Bot Token from @BotFather (required)
TG_BOT_TOKEN=

# Optional HTTP/HTTPS proxy if your server cannot reach api.telegram.org directly
# TG_PROXY=http://127.0.0.1:7890

# Optional custom Telegram Bot API reverse proxy (e.g., Cloudflare Worker)
# TG_API_BASE=https://api.telegram.org

# Local HTTP hook listener for coding agents
HOOK_HOST=127.0.0.1
HOOK_PORT=18790

# Persistent state file (defaults to ~/.local/state/rex-tg-bridge/state.json)
# STATE_FILE=/var/lib/rex-tg-bridge/state.json

# Default number of lines returned by /screen
CAPTURE_LINES=45

# Logging level: INFO, DEBUG, WARNING
LOG_LEVEL=INFO
